{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,

    "modules-left": ["hyprland/workspaces", "custom/cava"],
    "modules-center": ["clock"],
    "modules-right": ["idle_inhibitor", "tray", "cpu", "memory", "pulseaudio"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": ":3",
            "default": "·",
            "empty": "·"
        },
        "persistent-workspaces": {
            "*": 1
        }
    },

    "custom/cava": {
        "exec": "bash -c 'cava -p <(printf \"[general]\\nframerate=30\\nbars=12\\n[input]\\nmethod=pulse\\nsource=auto\\n[output]\\nmethod=raw\\nraw_target=/dev/stdout\\ndata_format=ascii\\nascii_max_range=7\\n\") | sed -u \"s/;//g;s/0/▁/g;s/1/▂/g;s/2/▃/g;s/3/▄/g;s/4/▅/g;s/5/▆/g;s/6/▇/g;s/7/█/g\"'",
        "format": "♪ {}",
        "tooltip": false
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "Awake",
            "deactivated": "Idle"
        }
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "  {:%A, %d %B %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "cpu": {
        "format": "CPU {usage}%",
        "tooltip": true,
        "interval": 3
    },

    "memory": {
        "format": "RAM {}%",
        "interval": 3
    },

    "pulseaudio": {
        "format": "Volume: {volume}%",
        "format-muted": "  Muted",
        "format-icons": {
            "default": ["·", "·", "·"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "scroll-step": 5
    }
}

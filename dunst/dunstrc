[global]
    monitor = 0
    follow = mouse

    ### Geometry ###
    width = 640
    height = (0, 120)
    origin = bottom-center
    offset = (24, 24)
    scale = 0
    notification_limit = 5

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 380
    progress_bar_corner_radius = 4

    ### Appearance ###
    transparency = 0
    corner_radius = 16
    frame_width = 2
    frame_color = "#CBB2FEAA"
    gap_size = 8
    separator_color = frame
    sort = yes
    idle_threshold = 120
    padding = 14
    horizontal_padding = 18

    ### Text ###
    font = JetBrainsMono Nerd Font 12
    line_height = 3
    markup = full
    format = "<span foreground='#CBB2FEAA'><b>%s</b></span>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Icons ###
    icon_position = left
    min_icon_size = 16
    max_icon_size = 32

    ### History ###
    sticky_history = yes
    history_length = 20

    ### Misc ###
    dmenu = /usr/bin/fuzzel --dmenu -p "DUNST ❯ "
    browser = xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    ignore_dbusclose = false

    ### Mouse ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#15114288"
    foreground = "#D8D4FF"
    frame_color = "#7B61FF88"
    highlight = "#A882FF"
    timeout = 5

[urgency_normal]
    background = "#15114299"
    foreground = "#E6E4FF"
    frame_color = "#CBB2FEAA"
    highlight = "#3CE5FF"
    timeout = 8

[urgency_critical]
    background = "#2B1038BB"
    foreground = "#FFE8F8"
    frame_color = "#FF4D8D"
    highlight = "#FF4D8D"
    timeout = 0

